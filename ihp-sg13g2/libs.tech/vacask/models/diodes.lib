//**************************************
//* Device: dantenna
//* Testfield: T262, IHP SG13S, Lot AWL403#A, Wafer 19, Chip 4,7, Segment S350B
//* DUTs: D1 (area), D2 (perimeter) and D4 (corners)
//* Temperature range: -40 degC ... +125 degC, DC range: -15 V ... 1 V
//* model is designed for reverse direction of the diodes, NO statistics
//*  DEV_A = area of the diode in um*um
//*  DEV_P = perimeter of the diode in um
//*  DEV_C = number of corners (default=4)
//*
//* Changes 2026-10 vs. previous version:
//*  - level=3 (ibv scales with area), nbv removed
//*  - tlev=1 tcv=-0.001, eg=1.20 (temperature dependence of bv and is)
//*  - dcorner: cj0=5e-18 added (convergence aid)
//**************************************

//*########################## dantenna models ############################

model darea sp_diode ( 
  tnom=27 is=2.315e-019 n=1.009 ik=1.434e-007 rs=2.193e+005 cj0=9.371e-016
  m=0.3036 vj=0.696 fc=0.5 bv=11.64 ibv=3.458e-007 tlev=1 tcv=-0.001
  isr=7.413e-019 xti=5.039 eg=1.20 trs=0 trs2=0 tt=7.009e-007
)
model dperim sp_diode ( 
  tnom=27 is=3.851e-021 n=1.022 rs=1.688e+006 ik=7.838e-008 isr=1.011e-017 xti=3
  bv=31.86 ibv=6.115e-014 cj0=1.821e-017 m=0.01923 vj=0.598 eg=1.20 tt=7.009e-007
)
model dcorner sp_diode ( 
  tnom=27 is=6.502e-021 n=1 rs=4.857e+005 ik=1e-006 isr=0 xti=3 bv=11.64
  ibv=3.458e-007 cj0=5e-18 m=0.5 vj=0.7 eg=1.20
)

subckt dantenna(1 2)
parameters l=780n
parameters w=780n
//*                (anode  cathode)
//*      (substrate/pWell  NSD)
parameters dev_a=(l*w)/1p dev_p=(l+w)/0.5u dev_c=4
d1 (1 2) darea  area=dev_a
d2 (1 2) dperim  area=dev_p
d3 (1 2) dcorner  area=dev_c
ends


//**************************************
//* Device: dpantenna
//* Testfield: T262, IHP SG13S, Lot AWL403#A, Wafer 19, Chip 4,7, Segment S351B
//* DUTs: D1 (area), D2 (perimeter) and D4 (corners)
//* Temperature range: -40 degC ... +125 degC, DC range: -15 V ... 1 V
//* model is designed for reverse direction of the diodes, NO statistics
//* bipolar effect in forward direction is NOT modeled
//*  DEV_A = area of the diode in um*um
//*  DEV_P = perimeter of the diode in um
//*  DEV_C = number of corners (default=4)
//*
//* Changes 2026-10 vs. previous version:
//*  - level=3 (ibv scales with area), nbv removed
//*  - tlev=1 tcv=-0.001, eg=1.20 (temperature dependence of bv and is)
//*  - dpcorner: cj0=3e-18 added (convergence aid)
//**************************************

//*########################## dpantenna models ###########################

model dparea sp_diode ( 
  tnom=27 is=8.569e-020 n=1.003 ik=2.957e-007 rs=1.728e+005 cj0=8.252e-016
  m=0.3171 vj=0.6628 fc=0.5 bv=12.14 ibv=1e-006 tlev=1 tcv=-0.001 isr=2.421e-019
  xti=4.56 eg=1.20 trs=0 trs2=0 tt=1e-012
)
model dpperim sp_diode ( 
  tnom=27 is=1.186e-020 n=1.006 rs=1.577e+006 ik=2.158e-008 isr=7.211e-018
  xti=4.118 bv=27.26 ibv=1.832e-011 cj0=3.657e-017 m=0.1512 vj=0.5241 eg=1.20
  tt=1e-012
)
model dpcorner sp_diode ( 
  tnom=27 is=6.965e-021 n=1 rs=4.734e+005 ik=1.19e-008 isr=0 xti=3 cj0=3e-18
  m=0.5 vj=0.7 eg=1.20
)

subckt dpantenna(1 2)
parameters l=780n
parameters w=780n
//*              (PSD  nWell)
//*             (anode  cathode)
parameters dev_a=(l*w)/1p dev_p=(l+w)/0.5u dev_c=4
d1 (1 2) dparea  area=dev_a
d2 (1 2) dpperim  area=dev_p
d3 (1 2) dpcorner  area=dev_c
ends


//**************************************
//* Device: isolbox
//* Testfield: T327
//* Technology: all IHP 0u13 technologies (SG13S, SG13G2)
//* Lot: PQE701
//* Wafer: 08
//* Chip: 6,4;6,5
//* DUTs: IS102..107;IS202...IS210
//* Temperature range: -40°C ... +125°C
//* DC range: -80V ... 1V (depending on pWellBlock width)
//* Operator: Teply
//* Date: 2016-03-31
//* Remarks: bipolar effect NOT taken into account
//*          model is designed for reverse direction of the diodes
//*          NO statistics
//*          initial model
//* Changes 2026-10 vs. previous version:
//*  - level=3 for models with bv (ibv scales with area)
//*  - eg=1.11 (all models), ns=1 (models with jsw)
//*  - tcv sign corrected (bv decreases with temperature)
//*  - ikp, rsw activated (dinneredge, dsubedge0, dsubedgexds)
//*  - doutcapcorner, doutcaparea: php, vj >= 0.39 V, cj/cjsw rescaled (no NaN at 125 degC)
//*************************************

//*******************************************************************************
//* isolbox
//*******************************************************************************

subckt isolbox(isosub nwell bn)
parameters l=3u w=3u aw=(w-2.1u)*(l-2.1u) pw=(w+l)*2-8*1.05u ab=(w*l) pb=(w+l)*2 xd=0 mf=1 scaling=1e-6 xds=xd/scaling pbs=pb/scaling abus=ab/(scaling*scaling) pws=pw/scaling aws=aw/(scaling*scaling)

xdpwdnw (isosub nwell) dpwdnw (
  l=l w=w aw=aw pw=pw xd=xd mf=mf scaling=scaling xds=xds pws=pws aws=aws
)

xdnwpsub (nwell bn) ddnwpsub (
  l=l w=w ab=ab pb=pb xd=xd mf=mf scaling=scaling xds=xds pbs=pbs abus=abus
)

ends


subckt dpwdnw(isosub nwell)
parameters l=3u w=3u aw=(w-2.1u)*(l-2.1u) pw=(w+l)*2-8*1.05u xd=0 mf=1 scaling=1e-6 xds=xd/scaling pws=pw/scaling aws=aw/(scaling*scaling)

dinner (isosub nwell) dinner_mod  area=mf*aws pj=0
dinneredge (isosub nwell) dinneredge_mod  area=mf*pws pj=mf*pws
dinrevl (nwell isosub) dinrevl_mod  area=mf*aws pj=0
dinrevlside (nwell isosub) dinrevlside_mod  area=mf*pws pj=0
dinrevh (nwell isosub) dinrevh_mod  area=mf*aws pj=0
dincaparea (isosub nwell) dincaparea_mod  area=mf*aws pj=mf*pws-3

model dinner_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 is=1.5e-19 n=1.02 ik=100e-9 xti=1.9 bv=9.7
  ibv=1e-12 nbv=0.1 tcv=698.557e-6 rs=5e5
)

model dinrevl_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 is=1e-18 n=100 xti=2200
)

model dinrevlside_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 is=10e-18 n=100 xti=2200
)

model dinrevh_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 is=3e-21 n=30 xti=700
)

model dincaparea_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 is=1e-25 cj=967.2e-18 cjsw=436e-18 mj=0.3436
  mjsw=0.3234 vj=0.7312 php=0.7036
)

model dinneredge_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 ns=1 is=3.89e-20 jsw=7.239e-20 n=1.01 ik=3e-6
  ikp=10e-6 xti=1.529 bv=9.7 ibv=1e-12 nbv=0.1 tcv=698.557e-6 isr=20e-18 rs=5e4
  rsw=12e3
)

ends


subckt ddnwpsub(nwell bn)
parameters l=3u w=3u ab=(w*l) pb=(w+l)*2 xd=0 mf=1 scaling=1e-6 xds=xd/scaling pbs=pb/scaling abus=ab/(scaling*scaling)

douter (bn nwell) dsub_mod  area=mf*abus pj=0

@if (xds<0.6)
   douteredge0 (bn nwell) dsubedge0_mod  area=mf*pbs pj=mf*pbs
@else
   douteredgexds (bn nwell) dsubedgexds_mod  area=mf*pbs pj=mf*pbs
@end

doutcapcorner (bn nwell) doutcapcorner_mod  area=1.0e-10 pj=mf*14.4
doutcaparea (bn nwell) doutcaparea_mod  area=mf*abus pj=mf*pbs

model dsub_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 is=4.052e-18 n=1.01 ik=1.023e-9 xti=2.112
  bv=94.7 nbv=6 tcv=422.386e-6 isr=86e-18 rs=5e5
)

model dsubedge0_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 ns=1 is=4.052e-18 n=1.01 jsw=17.26e-18
  ik=1.023e-9 ikp=10.73e-9 xti=2.112 bv=13.54 tcv=747.415e-6 isr=10e-18 nbv=0.5
  rs=10e3
)

model dsubedgexds_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 ns=1 is=4.052e-18 n=1.01 jsw=17.26e-18
  ik=1.023e-9 ikp=10.73e-9 xti=2.112
  bv=(-11.70818-8.218455*xds+9.586918*ln(xds)+51.45397*sqrt(xds)) tcv=980.73e-6
  nbv=5.452942+(0.4699715-5.452942)/((1+((xds/0.982607)**308.6349))**0.005495705)
  isr=1e-16 rs=28e3 rsw=16e3
)

model doutcapcorner_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 ns=1 jsw=1e-25
  cjsw=((389.8354-784.332*xds+736.9852*(xds**1.33)-91.4155*xds*xds+5.388092*xds*xds*xds)*1e-18)*(1-(0.3029153+16.37804*xds-16.45657*(xds**0.9972906))*(max(0.05502945+((0.51-0.05502945)/(1+((xds/1.059131)**7.087824))),0.1)-(0.05502945+((0.51-0.05502945)/(1+((xds/1.059131)**7.087824)))))/(0.05502945+((0.51-0.05502945)/(1+((xds/1.059131)**7.087824)))))*pow((1-(-5.0)/max(0.05502945+((0.51-0.05502945)/(1+((xds/1.059131)**7.087824))),0.39))/(1-(-5.0)/max(0.05502945+((0.51-0.05502945)/(1+((xds/1.059131)**7.087824))),0.1)),0.3029153+16.37804*xds-16.45657*(xds**0.9972906))
  mjsw=0.3029153+16.37804*xds-16.45657*(xds**0.9972906)
  php=max(0.05502945+((0.51-0.05502945)/(1+((xds/1.059131)**7.087824))),0.39)
  bv=(213.2898+(145-213.2898)/((1+(xds/0.9145351)**38.88081)**0.02169905))
  nbv=200
)

model doutcaparea_mod sp_diode ( 
  tnom=27 tlevc=0 tlev=2 eg=1.11 is=1e-25 cj=66.433e-18 mj=0.3874 vj=0.39
  cjsw=((471.3008-320.939*xds+91.4155*xds*xds-5.388092*xds*xds*xds)*1e-18)*(1-(0.2842892-0.1665323*xds+0.06902971*xds*xds-0.004775717*xds*xds*xds)*(max(0.6372219-0.6615502*sqrt(xds)+0.2246224*xds-0.0005250178*xds*xds*xds,0.1)-(0.6372219-0.6615502*sqrt(xds)+0.2246224*xds-0.0005250178*xds*xds*xds))/(0.6372219-0.6615502*sqrt(xds)+0.2246224*xds-0.0005250178*xds*xds*xds))*pow((1-(-5.0)/max(0.6372219-0.6615502*sqrt(xds)+0.2246224*xds-0.0005250178*xds*xds*xds,0.39))/(1-(-5.0)/max(0.6372219-0.6615502*sqrt(xds)+0.2246224*xds-0.0005250178*xds*xds*xds,0.1)),0.2842892-0.1665323*xds+0.06902971*xds*xds-0.004775717*xds*xds*xds)
  mjsw=0.2842892-0.1665323*xds+0.06902971*xds*xds-0.004775717*xds*xds*xds
  php=max(0.6372219-0.6615502*sqrt(xds)+0.2246224*xds-0.0005250178*xds*xds*xds,0.39)
  bv=(262.7082+((154.5533-262.7082)/(1+(xds/3.044691)**1.691568))) nbv=200
)

ends
