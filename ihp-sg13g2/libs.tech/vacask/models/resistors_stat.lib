//* NOTE:
//* values are one-sigma deviations (1/3 of min-max)

//* ngspice global statistical parameters
parameters drsh_rsil=4.67
parameters drsh_rppd=3.3
parameters drsh_rhigh=5.1
parameters dl_rsil=0.01
parameters dw_rsil=0.01
parameters dl_rppd=0.01
parameters dw_rppd=0.01
parameters dl_rhigh=0.02
parameters dw_rhigh=0.02
