//* NOTE:
//* values are one-sigma deviations (1/3 of min-max)

//* ngspice global statistical parameters
//* global number of standard deviations
parameters mc_nsig_rsh_rsil=agauss(0,1,1)
parameters mc_nsig_w_rsil=agauss(0,1,1)
parameters mc_nsig_l_rsil=agauss(0,1,1)
parameters mc_nsig_rsh_rppd=agauss(0,1,1)
parameters mc_nsig_w_rppd=agauss(0,1,1)
parameters mc_nsig_l_rppd=agauss(0,1,1)
parameters mc_nsig_rsh_rhigh=agauss(0,1,1)
parameters mc_nsig_w_rhigh=agauss(0,1,1)
parameters mc_nsig_l_rhigh=agauss(0,1,1)
parameters nsig_rsh_rsil=mc_nsig_rsh_rsil
parameters nsig_w_rsil=mc_nsig_w_rsil
parameters nsig_l_rsil=mc_nsig_l_rsil
parameters nsig_rsh_rhigh=mc_nsig_rsh_rhigh
parameters nsig_w_rhigh=mc_nsig_w_rhigh
parameters nsig_l_rhigh=mc_nsig_l_rhigh
parameters nsig_rsh_rppd=mc_nsig_rsh_rppd
parameters nsig_w_rppd=mc_nsig_w_rppd
parameters nsig_l_rppd=mc_nsig_l_rppd

//* global variation standard deviation
parameters drsh_rsil=4.67
parameters drsh_rppd=3.3
parameters drsh_rhigh=5.1
parameters dl_rsil=0.01
parameters dw_rsil=0.01
parameters dl_rppd=0.01
parameters dw_rppd=0.01
parameters dl_rhigh=0.02
parameters dw_rhigh=0.02
